<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btn_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <!-- Avatar Circle Outer Ring -->
        <RelativeLayout
            android:id="@+id/avatar_container"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_profile_ring"
            android:padding="3dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/img_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_stat_name"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </RelativeLayout>

        <!-- Online Status Badge (Bottom Right) -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignBottom="@id/avatar_container"
            android:layout_alignEnd="@id/avatar_container"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/widget_status_badge"
            android:contentDescription="@null" />
    </RelativeLayout>

</RelativeLayout>
