<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_global_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 1. Top Bar with Dimension Selector and Action Buttons [E] [T] [+] -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txt_dimension_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Dimensões ▾"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="#FFCC00"
                android:gravity="center"
                android:text="E"
                android:textColor="#121212"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="#A855F7"
                android:gravity="center"
                android:text="T"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="#3B82F6"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. Upper Split: Month Calendar (Left) & Agenda List (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <!-- Upper Left: Month Calendar (Displays ALL DAYS 1..31) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agosto 2026"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <!-- Days Header D S T Q Q S S -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7"
                android:paddingBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="D" android:textColor="#94A3B8" android:textSize="9sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:textColor="#94A3B8" android:textSize="9sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Q" android:textColor="#94A3B8" android:textSize="9sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Q" android:textColor="#94A3B8" android:textSize="9sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" android:gravity="center" />
            </LinearLayout>

            <!-- Complete Month Days 1..31 Grid (6 rows) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Row 1: . . . . . . 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="7">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                </LinearLayout>

                <!-- Row 2: 2..8 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="7">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textColor="#A855F7" android:textSize="9sp" android:gravity="center" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                </LinearLayout>

                <!-- Row 3: 9..15 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="7">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="10" android:textColor="#FFCC00" android:textSize="9sp" android:gravity="center" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="11" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="12" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="13" android:textColor="#A855F7" android:textSize="9sp" android:gravity="center" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="14" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="15" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                </LinearLayout>

                <!-- Row 4: 16..22 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="7">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="16" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="17" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="18" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="19" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="20" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="21" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="22" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                </LinearLayout>

                <!-- Row 5: 23..29 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="7">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="23" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="24" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="25" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="26" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="27" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="28" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="29" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                </LinearLayout>

                <!-- Row 6: 30..31 (COMPLETES ALL 31 DAYS OF THE MONTH!) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="7">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="30" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="31" android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2A2A2A" />

        <!-- Upper Right: Agenda Items List -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sem data"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D223B"
                android:padding="6dp"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dermatologista"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dia inteiro"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="feedback por email..."
                android:textColor="#FFCC00"
                android:textSize="10sp"
                android:background="#262626"
                android:padding="5dp"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="opcao no menu de..."
                android:textColor="#FFCC00"
                android:textSize="10sp"
                android:background="#262626"
                android:padding="5dp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2A"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- 3. Bottom Section: Visão Semanal (EXACTLY 1 SINGLE WEEK: 7 Days D 9 -> S 15) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7">

        <!-- D 9 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#262626" android:layout_marginTop="4dp" android:layout_marginHorizontal="2dp" />
        </LinearLayout>

        <!-- S 10 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#262626" android:layout_marginTop="4dp" android:layout_marginHorizontal="2dp" />
        </LinearLayout>

        <!-- T 11 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#262626" android:layout_marginTop="4dp" android:layout_marginHorizontal="2dp" />
        </LinearLayout>

        <!-- Q 12 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Q" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#262626" android:layout_marginTop="4dp" android:layout_marginHorizontal="2dp" />
        </LinearLayout>

        <!-- Q 13 (Selected/Current Day) -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Q" android:textColor="#A855F7" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="13" android:textColor="#A855F7" android:textSize="11sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#2D223B" android:layout_marginTop="4dp" android:layout_marginHorizontal="2dp" />
        </LinearLayout>

        <!-- S 14 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#262626" android:layout_marginTop="4dp" android:layout_marginHorizontal="2dp" />
        </LinearLayout>

        <!-- S 15 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#262626" android:layout_marginTop="4dp" android:layout_marginHorizontal="2dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
