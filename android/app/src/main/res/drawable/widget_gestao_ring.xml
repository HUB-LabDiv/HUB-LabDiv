<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Borda externa com degradê vertical oficial do HUB -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1F9FCF"
                android:centerColor="#FFCC00"
                android:endColor="#F14343"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Fundo interno escuro -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>

